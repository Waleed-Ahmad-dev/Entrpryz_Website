# Contact form — SMTP credentials (server-side only; never prefix with NEXT_PUBLIC_).
# Set these in Vercel → Project → Settings → Environment Variables.
#
# cPanel mailbox (current): SMTP_HOST=cloud772.thundercloud.uk, SMTP_PORT=465, SMTP_USER=connect@entrpryz.com
#   Use the cPanel server's own hostname: mail.entrpryz.com currently points at Vercel, not cPanel.
# Gmail example:          SMTP_HOST=smtp.gmail.com,   SMTP_PORT=465, SMTP_USER=entrpryz.digital@gmail.com
#                         (SMTP_PASS must be a Google "App password", not the account password)
SMTP_HOST=
SMTP_PORT=465
# Optional: "true" for implicit TLS (465), "false" for STARTTLS (587). Defaults from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Where inquiries are delivered (defaults to connect@entrpryz.com).
CONTACT_TO_EMAIL=
# Sender address; must be a mailbox SMTP_USER is allowed to send as (defaults to SMTP_USER).
CONTACT_FROM_EMAIL=

# Admin panel (/admin) — server-side only; never prefix with NEXT_PUBLIC_.
ADMIN_USERNAME=
# Use a long random password (20+ characters).
ADMIN_PASSWORD=
# Random string of at least 32 characters used to sign login sessions.
# Generate one with: openssl rand -base64 48
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Content editing (/admin) — edits are committed to GitHub, which redeploys on Vercel.
# Fine-grained personal access token: Repository access = only this repo,
# Permissions = Contents: Read and write (nothing else).
GITHUB_TOKEN=
# owner/name, e.g. Waleed-Ahmad-dev/Entrpryz_Website
GITHUB_REPO=
# Branch Vercel deploys from (defaults to main).
GITHUB_BRANCH=

# Search engine ownership tokens (optional; content="..." value only). DNS TXT verification also works.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
